# Kopier til .env og fyll inn. .env er i .gitignore – sjekk aldri inn nøkler.

# Fra Supabase: Project Settings → API
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service role-nøkkelen går utenom RLS. Kun server-side, aldri i frontend.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Delt passord for /admin.
ADMIN_PASSWORD="bytt-meg"

# CSV-lenken til regnearket påmeldingsskjemaet skriver til.
# Regneark → Fil → Del → Publiser på nettet → velg fanen og formatet CSV.
# Utelates den, kjører appen videre uten å hente skjemasvar.
GOOGLE_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/e/.../pub?gid=0&single=true&output=csv"
